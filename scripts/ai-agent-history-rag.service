# Native systemd user-unit reference. install-systemd.sh writes the concrete
# absolute paths and owner-only EnvironmentFile required for a deployment.
[Unit]
Description=AI Agent History RAG native daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Meridian/repos/ai-agent-history-rag-mcp
UnsetEnvironment=CLOUDSDK_CONFIG CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE GOOGLE_API_CERTIFICATE_CONFIG GOOGLE_APPLICATION_CREDENTIALS
EnvironmentFile=%h/.config/ai-agent-history-rag/history-ragd.env
ExecStart=%h/Meridian/repos/ai-agent-history-rag-mcp/bin/history-ragd supervise --config %h/.config/ai-agent-history-rag/history-ragd.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
